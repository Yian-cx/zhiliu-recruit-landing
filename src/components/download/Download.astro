---
import { DOWNLOAD_MACOS_ARM64, DOWNLOAD_MACOS_X64, DOWNLOAD_URL } from "../../data/site";
import SectionLabel from "../ui/SectionLabel.astro";
import GradientText from "../ui/GradientText.astro";
import Button from "../ui/Button.astro";
---

<!-- Download Section -->
<section id="download" class="relative py-24 md:py-32 overflow-hidden">
  <div class="absolute inset-0" style="background:
    radial-gradient(ellipse 60% 40% at 50% 0%, oklch(0.6 0.18 240 / 10%) 0%, transparent 50%),
    radial-gradient(ellipse 50% 40% at 50% 100%, oklch(0.65 0.2 265 / 8%) 0%, transparent 50%),
    var(--color-section-alt)"></div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div data-animate>
      <SectionLabel label="Download" />
    </div>
    <div data-animate style="transition-delay: 100ms">
      <GradientText as="h2" class="text-4xl sm:text-5xl md:text-6xl">
        立即下载职流
      </GradientText>
    </div>
    <p data-animate class="mt-4 text-lg text-foreground/40 max-w-xl mx-auto" style="transition-delay: 200ms">
      支持 macOS，Windows 版即将上线。完全免费，无需注册即可使用。
    </p>

    <!-- Platform Cards -->
    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-2xl mx-auto">
      <!-- macOS -->
      <div data-animate class="glass-card p-8 text-center" style="transition-delay: 300ms">
        <div class="size-16 rounded-2xl flex items-center justify-center mx-auto mb-5"
          style="background: linear-gradient(135deg, oklch(0.6 0.18 240 / 15%), oklch(0.65 0.2 265 / 10%))">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="oklch(0.65 0.2 265)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2c-1.5 0-3 .5-4 2-1 1.5-1 3 0 4 1 1 2.5 1.5 4 1s2.5-1 3-3c.5-1.5.5-3-.5-4C13.5 2 13 2 12 2z"/>
            <path d="M14 8c0 2-1 4-2 5s-3 1-5 0"/>
            <path d="M8 22h8"/>
            <path d="M12 16v6"/>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-foreground mb-2">macOS</h3>
        <p class="text-xs text-foreground/40 mb-6">Apple Silicon · Intel</p>
        <Button href={DOWNLOAD_MACOS_ARM64} variant="primary" class="w-full justify-center !py-3">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          下载 macOS 版
        </Button>
        <p class="mt-3 text-[10px] text-foreground/20">
          v0.1.0 · macOS 13+<br/>
          <a href={DOWNLOAD_MACOS_X64} class="hover:text-foreground/40 transition-colors">Intel 芯片版本</a> · <a href={DOWNLOAD_URL} class="hover:text-foreground/40 transition-colors">历史版本</a>
        </p>
      </div>

      <!-- Windows -->
      <div data-animate class="glass-card p-8 text-center opacity-60" style="transition-delay: 400ms">
        <div class="size-16 rounded-2xl flex items-center justify-center mx-auto mb-5"
          style="background: linear-gradient(135deg, oklch(0.6 0.18 240 / 8%), oklch(0.65 0.2 265 / 5%))">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="oklch(1 0 0 / 30%)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="M2 8h20"/>
            <path d="M12 8v12"/>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-foreground/50 mb-2">Windows</h3>
        <p class="text-xs text-foreground/20 mb-6">即将上线 · Coming Soon</p>
        <Button variant="secondary" class="w-full justify-center !py-3 pointer-events-none">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
          </svg>
          敬请期待
        </Button>
      </div>
    </div>

    <!-- System Requirements -->
    <div data-animate class="mt-12 flex flex-wrap items-center justify-center gap-6 text-xs text-foreground/25" style="transition-delay: 500ms">
      <span>macOS 13 (Ventura) 或更高版本</span>
      <span class="hidden sm:inline opacity-30">·</span>
      <span>Apple Silicon (M1-M5) / Intel 芯片</span>
      <span class="hidden sm:inline opacity-30">·</span>
      <span>完全免费</span>
    </div>
  </div>
</section>
