---
const footerLinks = [
  {
    title: "产品",
    links: [
      { label: "功能特性", href: "#features" },
      { label: "使用流程", href: "#how-it-works" },
      { label: "下载应用", href: "#download" },
    ],
  },
  {
    title: "资源",
    links: [
      { label: "使用文档", href: "#" },
      { label: "更新日志", href: "#" },
      { label: "常见问题", href: "#" },
    ],
  },
  {
    title: "关于",
    links: [
      { label: "关于我们", href: "#" },
      { label: "隐私政策", href: "#" },
      { label: "服务条款", href: "#" },
    ],
  },
  {
    title: "联系",
    links: [
      { label: "反馈建议", href: "#" },
      { label: "商务合作", href: "#" },
    ],
  },
];
---

<footer class="relative border-t border-white/[0.06] py-16 md:py-20" style="background: var(--color-background)">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8">
      <!-- Brand -->
      <div class="col-span-2 md:col-span-1">
        <a href="#" class="flex items-center gap-2.5 mb-4">
          <span class="size-8 rounded-lg flex items-center justify-center"
            style="background: linear-gradient(135deg, #0EA5E9, #3B82F6)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
            </svg>
          </span>
          <span class="text-sm font-bold tracking-tight gradient-text-cta">ZhiLiu</span>
        </a>
        <p class="text-xs text-foreground/30 leading-relaxed">
          AI 驱动的求职全流程管理工作台。
        </p>
      </div>

      {footerLinks.map((group) => (
        <div>
          <h4 class="text-xs font-semibold text-foreground/60 mb-3">{group.title}</h4>
          <ul class="space-y-2">
            {group.links.map((link) => (
              <li>
                <a href={link.href} class="text-xs text-foreground/30 hover:text-foreground/60 transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-12 pt-8 border-t border-white/[0.04] flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-foreground/20">
        &copy; {new Date().getFullYear()} ZhiLiu. All rights reserved.
      </p>
      <p class="text-xs text-foreground/20">
        用 AI 赋能每一位求职者
      </p>
    </div>
  </div>
</footer>
