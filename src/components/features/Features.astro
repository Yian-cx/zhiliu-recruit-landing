---
import { features } from "../../data/features";
import SectionLabel from "../ui/SectionLabel.astro";
import GradientText from "../ui/GradientText.astro";

const iconPaths: Record<string, string> = {
  building: '<rect x="4" y="2" width="16" height="20" rx="2"/><line x1="9" y1="6" x2="9" y2="6.01"/><line x1="15" y1="6" x2="15" y2="6.01"/><line x1="9" y1="10" x2="9" y2="10.01"/><line x1="15" y1="10" x2="15" y2="10.01"/><line x1="9" y1="14" x2="9" y2="14.01"/><line x1="15" y1="14" x2="15" y2="14.01"/><path d="M9 18h6"/><path d="M12 2v18"/>',
  layout: '<rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/>',
  "file-text": '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>',
  "message-circle": '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.5 8.5 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>',
  scale: '<circle cx="16" cy="16" r="6"/><circle cx="8" cy="8" r="6"/><line x1="11" y1="11" x2="14" y2="14"/>',
  calendar: '<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>',
  compass: '<circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>',
  "chart-bar": '<line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/>',
};
---

<!-- Features Section -->
<section id="features" class="relative py-24 md:py-32 lg:py-40 overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0" style="background:
    radial-gradient(ellipse 60% 40% at 0% 30%, oklch(0.6 0.18 250 / 8%) 0%, transparent 50%),
    radial-gradient(ellipse 50% 40% at 100% 70%, oklch(0.55 0.16 280 / 6%) 0%, transparent 50%),
    var(--color-section-alt)"></div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-16 md:mb-20">
      <div data-animate>
        <SectionLabel label="Features" />
      </div>
      <div data-animate style="transition-delay: 100ms">
        <GradientText as="h2" class="text-4xl sm:text-5xl md:text-6xl">
          全方位求职利器
        </GradientText>
      </div>
      <p data-animate class="mt-4 text-lg text-foreground/40 max-w-xl mx-auto" style="transition-delay: 200ms">
        从投递到入职，每个环节都有 AI 辅助
      </p>
    </div>

    <!-- Features Grid -->
    <div class="stagger-children grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {features.map((feature) => (
        <div data-animate class="glass-card p-6 group cursor-default">
          <!-- Icon -->
          <div class="size-12 rounded-xl flex items-center justify-center mb-4 transition-transform duration-300 group-hover:scale-110"
            style="background: linear-gradient(135deg, oklch(0.6 0.18 240 / 15%), oklch(0.65 0.2 265 / 10%))">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="oklch(0.65 0.2 265)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={iconPaths[feature.icon] || ''} />
          </div>
          <h3 class="text-sm font-semibold text-foreground mb-1.5">{feature.title}</h3>
          <p class="text-xs text-foreground/40 leading-relaxed">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
